# Copia este archivo a ".env" y rellena los valores.
# .env esta en .gitignore: nunca se sube al repositorio.

# PIN/token de acceso al deck. Si lo dejas vacio, el servidor genera
# un PIN aleatorio de 6 digitos en cada arranque (se imprime en consola).
DECK_TOKEN=

# Password del WebSocket de OBS:
# OBS -> Herramientas -> Ajustes del servidor WebSocket -> Mostrar password
OBS_PASSWORD=
